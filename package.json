{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "cra-template": "1.2.0",
    "firebase": "^11.3.1",
    "parcel": "^2.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "react-scripts": "^5.0.1",
    "react-uuid": "^2.0.0"
  },
  "scripts": {
    "start": "parcel ./src/app.js",
    "build": "parcel build --dist-dir docs --public-url /trainlinkit/ ./src/app.js",
    "dev:build": "parcel build --dist-dir dist --no-content-hash ./src/app.js",
    "dev:run": "npm run dev:build && npm run dev:start",
    "dev:start": "parcel serve --dist-dir dist ./src/app.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "process": "^0.11.10"
  }
}
